+    private static LedeType ParseLedeType(string? raw)
+    {
+        if (string.IsNullOrWhiteSpace(raw)) return LedeType.Summary;
+        var v = raw.Trim();
+        // Legacy "creative" from the 2-value enum — map to Anecdotal as closest generic creative fallback
+        if (string.Equals(v, "creative", StringComparison.OrdinalIgnoreCase)) return LedeType.Anecdotal;
+        // Case-insensitive parse; model may return camelCase wire values
+        if (Enum.TryParse<LedeType>(v, ignoreCase: true, out var parsed)) return parsed;
+        // Try without hyphens/underscores/spaces (e.g. "immediate-identification" -> ImmediateIdentification)
+        var normalized = v.Replace("-", "").Replace("_", "").Replace(" ", "");
+        if (Enum.TryParse<LedeType>(normalized, ignoreCase: true, out parsed)) return parsed;
+        throw new ContentGenerationException($"Unknown ledeType '{raw}' — expected one of: summary, immediateIdentification, delayedIdentification, singleItem, anecdotal, narrative, sceneSetting, startlingStatement, directAddress, question, quote, wordplay");
+    }
