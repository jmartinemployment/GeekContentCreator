+    // --- helpers appended to class ---
+    private static string LedeTypeCatalogBlock() => string.Join(Environment.NewLine, new[]
+    {
+        "LEDE TYPES (pick one):",
+        "  Direct News:",
+        "    - summary: Lead with key fact/outcome (e.g. \"FedEx integrated predictive AI across 50 hubs, cutting delays by 14%\")",
+        "    - immediateIdentification: Name the person/org/event immediately (e.g. \"OpenAI CEO Sam Altman warned...\")",
+        "    - delayedIdentification: Describe situation first, reveal key actor later (e.g. \"A mid-sized Ohio plant quieted its line... after launching a neural network\")",
+        "    - singleItem: Focus on one critical factor/finding (e.g. \"Clean, well-structured data emerged as the single biggest factor...\")",
+        "  Creative and Feature:",
+        "    - anecdotal: Short relatable story or mistake (e.g. \"When Sarah Jenkins launched her internal AI, it spent three hours giving away free coupon codes\")",
+        "    - narrative: Set a dramatic scene with action/tension (e.g. \"The room fell dead silent as the team pressed Enter...\")",
+        "    - sceneSetting: Vivid sensory details establishing context (e.g. \"Fluorescent lights hummed over empty desks at midnight...\")",
+        "    - startlingStatement: Shocking statistic or claim (e.g. \"Up to 85% of corporate AI projects fail before deployment\")",
+        "    - directAddress: Speak directly to the reader (e.g. \"If you are still waiting for the perfect time to implement AI, your competitors have already...\")",
+        "    - question: Pose a compelling question (e.g. \"Why do elite teams still struggle to get a basic AI chatbot running?\")",
+        "    - quote: Open with an expert/subject quote (e.g. \"Implementing AI isn't a technology problem, it's a culture shock,\" says consultant Marcus Vance)",
+        "    - wordplay: Use puns, metaphors, or clever language (e.g. \"Many companies automated their own artificial stupidity\")",
+    });
+
+    private static string BuildAudienceAngleGuidance(ProjectGenerationContext context)
+    {
+        var audienceSegment = string.IsNullOrWhiteSpace(context.AudienceSegment) ? "(not specified)" : context.AudienceSegment;
+        var audienceDetails = context.AudienceDetails is { Count: > 0 } d ? string.Join(", ", d) : "(none)";
+        var audienceNotes = string.IsNullOrWhiteSpace(context.AudienceNotes) ? "(none)" : context.AudienceNotes.Trim();
+        var angle = string.IsNullOrWhiteSpace(context.ContentAngle) ? "(not specified)" : context.ContentAngle;
+        return string.Join(Environment.NewLine, new[]
+        {
+            $"Audience: {audienceSegment} — details: {audienceDetails} — notes: {audienceNotes}",
+            $"Angle: {angle}",
+            "Lede guidance by angle: comparative→ question/startlingStatement/singleItem; problem_solution→ anecdotal/sceneSetting/directAddress/question; case_study_data→ immediateIdentification/singleItem/quote/startlingStatement; ultimate_guide→ summary/delayedIdentification/directAddress.",
+            "Lede guidance by audience: affinity/in_market→ more narrative/anecdotal room; detailed_demographics/your_data→ more directAddress/question; life_events/custom→ follow notes closely.",
+        });
+    }
