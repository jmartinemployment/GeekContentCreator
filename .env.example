# Geek Content Creator → GeekOAuth → GeekAPI (hosts Content Writer v2 generate)
# Never call GeekRepository from this app.

NEXT_PUBLIC_APP_URL=http://localhost:3003
NEXT_PUBLIC_AUTH_URL=http://localhost:5001
# On macOS, :5000 is often AirPlay — use :8080 for local GeekAPI if needed
NEXT_PUBLIC_GEEK_API_URL=http://localhost:8080

NEXT_PUBLIC_OAUTH_CLIENT_ID=geek-content-creator
NEXT_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:3003/auth/callback

# Optional: server-only fallback for /api/cw proxy when no user session
# GEEK_BACKEND_API_KEY=

# Production (Vercel) typically:
# NEXT_PUBLIC_APP_URL=https://geek-content-creator.vercel.app
# NEXT_PUBLIC_AUTH_URL=https://auth.geekatyourspot.com
# NEXT_PUBLIC_GEEK_API_URL=https://api.geekatyourspot.com
# NEXT_PUBLIC_OAUTH_REDIRECT_URI=https://geek-content-creator.vercel.app/auth/callback
# GEEK_BACKEND_API_KEY=<same key GeekAPI expects>
